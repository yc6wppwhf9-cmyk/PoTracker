# Copy to api/.env and fill in.
# Supabase (project: Procurement on Erp)
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key (safe on the backend; RLS applies via the caller's JWT)
SUPABASE_ANON_KEY=

# Claude — used by the /ai endpoints (executive summary, fuzzy match).
# Paste your Anthropic API key here. It stays server-side; never exposed to the browser.
ANTHROPIC_API_KEY=

# CORS: comma-separated allowed origins for the Next.js frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:49763

# Transactional email (Resend). Absent key => notifications are skipped, never fatal.
RESEND_API_KEY=
RESEND_FROM=PoTracker <potracker@hscvpl.com>

# Public URL of the Next.js app; used to build links inside notification emails.
APP_URL=http://localhost:3000

# Testing: redirect every notification to this address instead of its real
# recipients. Subject is tagged [TEST] and the body lists who it would have
# gone to. Leave EMPTY in production.
NOTIFY_OVERRIDE_TO=
