# Copy to api/.env and fill in.
# Supabase (project: Procurement on Erp)
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key (safe on the backend; RLS applies via the caller's JWT)
SUPABASE_ANON_KEY=

# Claude — used by the /ai endpoints (executive summary, fuzzy match).
# Paste your Anthropic API key here. It stays server-side; never exposed to the browser.
ANTHROPIC_API_KEY=

# CORS: comma-separated allowed origins for the Next.js frontend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:49763
